{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.test-d.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts",
    "__tests__/phase-0/**/*.test-d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
