order-input hover:bg-accent hover:text-accent-foreground">7</button><button type="button" role="radio" aria-checked="false" aria-label="Rate 8 out of 10" tabindex="-1" class="inline-flex items-center justify-center border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring h-10 w-10 text-base rounded-md font-medium bg-background text-foreground border-input hover:bg-accent hover:text-accent-foreground">8</button><button type="button" role="radio" aria-checked="false" aria-label="Rate 9 out of 10" tabindex="-1" class="inline-flex items-center justify-center border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring h-10 w-10 text-base rounded-md font-medium bg-background text-foreground border-input hover:bg-accent hover:text-accent-foreground">9</button><button type="button" role="radio" aria-checked="false" aria-label="Rate 10 out of 10" tabindex="-1" class="inline-flex items-center justify-center border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring h-10 w-10 text-base rounded-md font-medium bg-background text-foreground border-input hover:bg-accent hover:text-accent-foreground">10</button></div><div class="flex justify-between text-xs text-muted-foreground"><span>Not likely</span><span>Very likely</span></div></div><div class="flex items-center justify-between gap-2"><span></span><button type="button" disabled="" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">Submit</button></div></div><button type="button" aria-label="Close survey" class="absolute right-4 top-4 rounded-sm opacity-70 hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"><span aria-hidden="true">×</span></button></div>"`;
