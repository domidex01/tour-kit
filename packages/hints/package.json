{
  "name": "@tour-kit/hints",
  "version": "1.0.7",
  "description": "React feature hints, hotspots & beacons — pulse-animated indicators with dismissal tracking, works with or without Tailwind.",
  "author": "Tour Kit Team",
  "license": "MIT",
  "homepage": "https://usertourkit.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domidex01/tour-kit.git",
    "directory": "packages/hints"
  },
  "bugs": {
    "url": "https://github.com/domidex01/tour-kit/issues"
  },
  "keywords": [
    "feature-hint",
    "hotspot",
    "beacon",
    "feature-discovery",
    "feature-callout",
    "in-app-hint",
    "coachmark",
    "tooltip",
    "popover",
    "pulse",
    "react-hints",
    "onboarding",
    "headless",
    "shadcn",
    "tour-kit",
    "userpilot-alternative",
    "appcues-alternative"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind/index.d.ts",
        "default": "./dist/tailwind/index.js"
      },
      "require": {
        "types": "./dist/tailwind/index.d.cts",
        "default": "./dist/tailwind/index.cjs"
      }
    },
    "./styles/variables.css": "./src/styles/variables.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles.css": "./dist/styles/variables.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src/styles", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tour-kit/core": "workspace:*",
    "@tour-kit/media": "workspace:*",
    "@floating-ui/react": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "class-variance-authority": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0",
    "@mui/base": "catalog:",
    "@tour-kit/analytics": "workspace:*"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "@mui/base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
