# Polar webhook secret (Polar dashboard > Webhooks > Secret)
# Format: whsec_<base64-encoded-secret>
POLAR_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- Polar checkout, one URL per tier ---
# Polar dashboard > Products > Checkout link, for each of the three products.
# The prices charged live in Polar; lib/pricing.ts only *displays* them, so the
# two must be kept in step or the page advertises a price checkout does not
# honour. Currently: Starter $9.99, Business $49.99, Premium $299.99.
#
# A missing URL is not a crash — checkoutUrl() falls back to /pricing rather
# than an empty href — but it is a Buy button that cannot sell. Measured
# 2026-09-02: 2.56% of visitors clicked Buy and 0% completed.
NEXT_PUBLIC_POLAR_CHECKOUT_URL_STARTER=
NEXT_PUBLIC_POLAR_CHECKOUT_URL_BUSINESS=
NEXT_PUBLIC_POLAR_CHECKOUT_URL_PREMIUM=

# Polar-hosted customer portal, e.g. https://polar.sh/<org-slug>/portal
NEXT_PUBLIC_POLAR_PORTAL_URL=

# --- Analytics ---
# Google Analytics 4 measurement id. Sets _ga cookies, which /legal/privacy
# discloses.
NEXT_PUBLIC_GA_ID=

# PostHog project key (EU Cloud). Leave empty and PostHog never loads and none
# of its bytes ship; /legal/privacy renders without the PostHog disclosure to
# match. Ingestion is reverse-proxied through /ingest (see next.config.mjs), so
# no PostHog host needs to appear in the CSP.
NEXT_PUBLIC_POSTHOG_KEY=

# --- Polar customer portal integration ---
# Polar server-side SDK (server-only, NEVER prefix NEXT_PUBLIC_)
POLAR_ACCESS_TOKEN=
# Resend (webhook alerts + /account portal email delivery)
RESEND_API_KEY=
# Inbox that receives webhook ops alerts (refunds, benefit revocations)
OPS_ALERT_EMAIL=
